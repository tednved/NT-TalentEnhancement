      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGiveStat stattype="DualWieldingPenaltyReduction" value="0.5" />
        </Abilities>
      </AbilityGroupEffect>
      <AddedRecipe itemidentifier="handcannon" />
      <AddedRecipe itemidentifier="handcannonround" />
    </Talent>
    <!-- 第二系列天赋 -->
    <!-- 以身作则 -->
    <Talent identifier="leadingbyexample">
      <Icon texture="Content/UI/TalentsIcons2.png" sheetindex="1,5" sheetelementsize="128,128" />
      <!-- 文本：只要你还活着，所有船员都会获得士气高涨并获得以下好处： -->
      <Description tag="talentdescription.leadingbyexample" />
      <!-- 文本：+20% 修复速度 -->
      <Description tag="talentdescription.additionalstattype">
        <Replace tag="[amount]" value="20" color="gui.green" />
        <Replace tag="[stattype]" value="stattypenames.repairspeed" color="gui.orange" />
      </Description>
      <!-- 文本：+20% 船体修复速度 -->
      <Description tag="talentdescription.additionalstattype">
        <Replace tag="[amount]" value="20" color="gui.green" />
        <Replace tag="[stattype]" value="stattypenames.repairtoolstructurerepairmultiplier" color="gui.orange" />
      </Description>
      <!-- 文本：+5% 移动速度 -->
      <Description tag="talentdescription.additionalstattype">
        <Replace tag="[amount]" value="5" color="gui.green" />
        <Replace tag="[stattype]" value="stattypenames.movementspeed" color="gui.orange" />
      </Description>
      <AbilityGroupInterval interval="0.9">
        <Conditions>
          <!-- 所有船员中是否有人持有family(家庭)天赋 -->
          <AbilityConditionAllyHasTalent identifier="family" />
          <AbilityConditionNoCrewDied />
        </Conditions>
        <Abilities>
          <!-- 给所有船员施加excellentmorale -->
          <CharacterAbilityApplyStatusEffectsToAllies allowself="true" requiresalive="true" allowclientsimulation="false">
            <StatusEffects>
              <StatusEffect type="OnAbility" target="Character" disabledeltatime="true" multiplyafflictionsbymaxvitality="true">
                <Affliction identifier="excellentmorale" strength="1.0" />
              </StatusEffect>
            </StatusEffects>
          </CharacterAbilityApplyStatusEffectsToAllies>
        </Abilities>
        <FallbackAbilities>
          <!-- 如果角色没有"family"天赋，则给予"high morale" -->
          <CharacterAbilityApplyStatusEffectsToAllies allowself="true" requiresalive="true" allowclientsimulation="false">
            <StatusEffects>
              <StatusEffect type="OnAbility" target="Character" disabledeltatime="true" multiplyafflictionsbymaxvitality="true">
                <Affliction identifier="highmorale" strength="1.0" />
                <ReduceAffliction identifier="excellentmorale" strength="1.0" />
              </StatusEffect>
            </StatusEffects>
          </CharacterAbilityApplyStatusEffectsToAllies>
        </FallbackAbilities>
      </AbilityGroupInterval>
    </Talent>
    <!-- 舵手 -->
    <Talent identifier="helmsman">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="7,4" sheetelementsize="128,128" />
      <!-- 文本：你的驾驶技能提高30。 -->
      <Description tag="talentdescription.helmsman">
        <Replace tag="[amount]" value="30" color="gui.green" />
      </Description>
      <!-- 引擎和水泵效率提高20%。 -->
      <Description tag="talentdescription.increaseeffectiveness">
        <Replace tag="[amount]" value="20" color="gui.green" />
      </Description>
      <!-- 多个相同天赋效果不叠加。 -->
      <Description tag="talentdescription.doesnotstack" />
      <!-- 提供30驾驶技能 -->
      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGiveStat stattype="HelmSkillBonus" value="30" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 每60秒提供一次 引擎和水泵效率提升（解决换船、复活等情况） -->
      <AbilityGroupInterval interval="60">
        <Abilities>
          <CharacterAbilityGiveItemStatToTags tags="pump" stattype="PumpSpeed" stackable="false" value="1.2" />
          <CharacterAbilityGiveItemStatToTags tags="engine" stattype="EngineSpeed" stackable="false" value="1.2" />
        </Abilities>
      </AbilityGroupInterval>
      <!-- 提供引擎和水泵效率提升 -->
      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGiveItemStatToTags tags="pump" stattype="PumpSpeed" stackable="false" value="1.2" />
          <CharacterAbilityGiveItemStatToTags tags="engine" stattype="EngineSpeed" stackable="false" value="1.2" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- 鼓舞人心 -->
    <Talent identifier="inspiringpresence">
      <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="5,1" sheetelementsize="128,128" />
      <!-- 文本：只要你还活着，全体船员手术中受到的创伤性休克-25%、精神创伤-50%（同安全官急救训练机制） -->
      <Description tag="talentdescription.tesp_inspiringpresence">
        <Replace tag="[traumashock]" value="25" color="gui.green" />
        <Replace tag="[neurotrauma]" value="50" color="gui.green" />
      </Description>
      <!-- 只要你还活着，给全体船员施加创伤抗性标记 -->
      <AbilityGroupInterval interval="0.9">
        <Abilities>
          <CharacterAbilityApplyStatusEffectsToAllies allowself="true" requiresalive="true">
            <StatusEffects>
              <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
                <Affliction identifier="tesp_inspiringpresence" strength="1.0" />
              </StatusEffect>
            </StatusEffects>
          </CharacterAbilityApplyStatusEffectsToAllies>
        </Abilities>
      </AbilityGroupInterval>
    </Talent>
    <!-- 涓涓细流 -->
    <Talent identifier="trickledown">
      <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="3,1" sheetelementsize="128,128" />
      <!-- 文本：你获得技能点时其他船员也都将获得技能点。船员游泳速度提高10%。 -->
      <Description tag="talentdescription.trickledown">
        <Replace tag="[amount]" value="10" color="gui.green" />
      </Description>
      <!-- 技能点时其他船员也获得技能点。 -->
      <AbilityGroupEffect abilityeffecttype="OnGainSkillPoint">
        <Abilities>
          <CharacterAbilityGainSimultaneousSkill skillidentifier="inherit" targetallies="true" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 船员游泳速度提高10%。 -->
      <AbilityGroupInterval interval="0.9">
        <Abilities>
          <CharacterAbilityApplyStatusEffectsToAllies allowself="true" requiresalive="true">
            <StatusEffects>
              <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
                <Affliction identifier="trickledown" strength="1.0" />
              </StatusEffect>
            </StatusEffects>
          </CharacterAbilityApplyStatusEffectsToAllies>
        </Abilities>
      </AbilityGroupInterval>
    </Talent>
    <!-- 家庭：解锁时:每位船员提高一级。如果任务中没有任何船员死亡，则将士气高涨升级为亢进士气，加成加倍。每次你在巡回中完成所有任务后，会获得10点驾驶技能奖励，此天赋只能给与至多200技能点，这个奖励会在死亡时消失。 -->
    <Talent identifier="family">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,1" sheetelementsize="128,128" />
      <!-- 文本：解锁时:每位船员提高一级。-->
      <Description tag="talentdescription.family" />
      <!-- 文本：如果任务中没有任何船员死亡，则将士气高涨升级为亢进士气，加成加倍。-->
      <Description tag="talentdescription.family2" />
      <!-- 文本：每次你在巡回中完成所有任务后，会获得10点驾驶技能奖励。 -->
      <Description tag="talentdescription.truckernew">
        <Replace tag="[skillamount]" value="10" color="gui.green" />
      </Description>
      <!-- 文本：此天赋只能给与至多200技能点。 -->
      <Description tag="talentdescription.maxskillfromtalent">
        <Replace tag="[skillamount]" value="200" color="gui.green" />
      </Description>
      <!-- 文本：这个奖励会在死亡时消失。 -->
      <Description tag="talentdescription.bonuslostondeath" />
      <AbilityGroupEffect abilityeffecttype="None">
        <Conditions>
          <AbilityConditionHasPermanentStat statidentifier="family" min="1" invert="true" />
        </Conditions>
        <Abilities>
          <CharacterAbilityGiveTalentPointsToAllies amount="1" />
          <CharacterAbilityGivePermanentStat statidentifier="family" value="1" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 在所有任务完成后 -->
      <AbilityGroupEffect abilityeffecttype="OnAllMissionsCompleted">
        <Abilities>
          <CharacterAbilityGivePermanentStat statidentifier="trucker" stattype="HelmSkillBonus" value="10" maxvalue="200" removeondeath="true" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- 第三系天赋 -->
    <!-- 赞扬-->
    <Talent identifier="commendations">
      <!-- 每当你完成至少一个任务，就会获得2个联盟奖章。当你对其他角色使用联盟奖章时，会给他们275经验。 -->
      <Description tag="talentdescription.commendationsnew">
        <Replace tag="[num]" value="2" color="gui.green" />
        <Replace tag="[itemname]" value="entityname.coalitioncommendation" color="gui.orange" />
        <Replace tag="[selfxpgain]" value="275" color="gui.green" />
      </Description>
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="1,1" sheetelementsize="128,128" />
      <!-- 完成至少一个任务提供2个物品 -->
      <AbilityGroupEffect abilityeffecttype="OnAnyMissionCompleted">
        <Conditions>
          <!-- 检查是否拥有figurehead天赋 -->
          <AbilityConditionHasTalent identifier="figurehead" />
        </Conditions>
        <Abilities>
          <!-- 如果拥有figurehead天赋，则给予coalitionmedal(联盟勋章) -->
          <CharacterAbilityPutItem itemidentifier="coalitionmedal" amount="2" />
        </Abilities>
        <FallbackAbilities>
          <!-- 如果没有figurehead天赋，则给予coalitioncommendation(联盟奖章) -->
          <CharacterAbilityPutItem itemidentifier="coalitioncommendation" amount="2" />
        </FallbackAbilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- 威望 -->
    <Talent identifier="yourreputationnew">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,6" sheetelementsize="128,128" />
      <!-- 文本：你可以多选择一个任务。 -->
      <Description tag="talentdescription.extramission" />
      <!-- 文本：船员的声望获取量提升 50%。 -->
      <Description tag="talentdescription.increasereputationgains">
        <Replace tag="[value]" value="50" color="gui.green" />
      </Description>
      <!-- 文本：每当你进入拥有声望的新前哨，就会得到500马克，城市翻倍。 -->
      <Description tag="talentdescription.yourreputationnew">
        <Replace tag="[amount]" value="500" color="gui.green" />
      </Description>
      <!-- 效果：增加 1 任务选择数量和 50% 声望获取 -->
      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGiveStat stattype="ExtraMissionCount" value="1" />
          <CharacterAbilityGiveStat stattype="ReputationGainMultiplier" value="0.5" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 效果：进入拥有声望的新前哨时获得马克 -->
      <AbilityGroupEffect abilityeffecttype="OnLocationDiscovered">
        <Conditions>
          <AbilityConditionLocation hasoutpost="true" ispositivereputation="true" />
        </Conditions>
        <Abilities>
          <CharacterAbilityGiveMoney amount="500" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 效果：进入拥有声望的新城市前哨时获得马克（城市翻倍） -->
      <AbilityGroupEffect abilityeffecttype="OnLocationDiscovered">
        <Conditions>
          <AbilityConditionLocation hasoutpost="true" ispositivereputation="true" locationtype="City" />
        </Conditions>
        <Abilities>
          <CharacterAbilityGiveMoney amount="500" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- 盟约：完成任务没人死亡，全队任务经验+30％，血量+5％ -->
    <Talent identifier="affiliation">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="1,4" sheetelementsize="128,128" />
      <!-- 文本：完成附属阵营任务的马克奖励提高20% -->
      <Description tag="talentdescription.affiliationbenefit">
        <Replace tag="[amount]" value="20" color="gui.green" />
      </Description>
      <!-- 文本：每当你完成任务而没有任何船员死亡，你的船员就会获得额外30%经验，并增加5%的最大生命，上限为30%的最大生命。 -->
      <Description tag="talentdescription.affiliationnew">
        <Replace tag="[extraexperience]" value="30" color="gui.green" />
        <Replace tag="[largegain]" value="5" color="gui.green" />
        <Replace tag="[maxgain]" value="30" color="gui.green" />
      </Description>
      <!-- 文本：助手的死亡不计算在内。 -->
      <Description tag="talentdescription.assistantsdontcount" />
      <!-- 文本：附属阵营：你声望最高的阵营。 -->
      <Description tag="talentdescription.affiliationfactionreminder" />
      <!-- 效果：附属阵营任务提高20%马克 -->
      <AbilityGroupEffect abilityeffecttype="OnGainMissionMoney">
        <Conditions>
          <AbilityConditionMission isaffiliated="true" />
        </Conditions>
        <Abilities>
          <CharacterAbilityModifyValue multiplyValue="1.2" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 效果：完成任务且无人死亡时获得额外经验与生命值 -->
      <AbilityGroupEffect abilityeffecttype="OnAllyGainMissionExperience">
        <Conditions>
          <AbilityConditionNoCrewDied />
        </Conditions>
        <Abilities>
          <CharacterAbilityModifyValue multiplyvalue="1.3" />
          <CharacterAbilityGivePermanentStat statidentifier="trustbuilding" stattype="MaximumHealthMultiplier" value="0.05" maxvalue="0.30" targetallies="true" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- 人脉 -->
    <Talent identifier="networking">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="3,2" sheetelementsize="128,128" />
      <!-- 文本：附属阵营的船厂在升级和购买潜艇时提供20%的折扣。 -->
      <Description tag="talentdescription.campaigning">
        <Replace tag="[amount]" value="20" color="gui.green" />
      </Description>
      <!-- 文本：附属阵营的商店提供20%折扣。对于派系独占物品，折扣翻倍。 -->
      <Description tag="talentdescription.networking">
        <Replace tag="[amount]" value="20" color="gui.green" />
      </Description>
      <!-- 文本：附属阵营：你声望最高的阵营。 -->
      <Description tag="talentdescription.affiliationfactionreminder" />
      <!-- 效果：提供20%的折扣。 -->
      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGivePermanentStat statidentifier="campaigning" stattype="ShipyardBuyMultiplierAffiliated" value="0.2" setvalue="true" />
          <CharacterAbilityGivePermanentStat statidentifier="all~networking" stattype="StoreBuyMultiplierAffiliated" value="0.2" setvalue="true" />
          <CharacterAbilityGivePermanentStat statidentifier="coalition" stattype="StoreBuyMultiplierAffiliated" value="0.2" setvalue="true" />
          <CharacterAbilityGivePermanentStat statidentifier="clowns" stattype="StoreBuyMultiplierAffiliated" value="0.2" setvalue="true" />
          <CharacterAbilityGivePermanentStat statidentifier="huskcult" stattype="StoreBuyMultiplierAffiliated" value="0.2" setvalue="true" />
          <CharacterAbilityGivePermanentStat statidentifier="separatists" stattype="StoreBuyMultiplierAffiliated" value="0.2" setvalue="true" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- 领袖人物 -->
    <Talent identifier="figurehead">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,4" sheetelementsize="128,128" />
      <!-- 文本：所有附属阵营前哨站的服务都有20%的折扣。 -->
      <Description tag="talentdescription.factiondiscount">
        <Replace tag="[discount]" value="20" color="gui.green" />
      </Description>
      <!-- 文本：替换联盟勋章为联盟奖章，当你对其他角色使用联盟勋章时，同时给予自己和对方550经验。如果该角色的等级低于5，则提升到5级。 -->
      <Description tag="talentdescription.figureheadnew">
        <Replace tag="[itemname1]" value="entityname.coalitioncommendation" color="gui.orange" />
        <Replace tag="[itemname2]" value="entityname.coalitionmedal" color="gui.orange" />
        <Replace tag="[selfxpgain]" value="550" color="gui.green" />
        <Replace tag="[level]" value="5" color="gui.green" />
      </Description>
      <!-- 文本：如果你在你的潜艇上，并且已经进水80%，你会保持完全清醒的状态，至少持续15秒。 -->
      <Description tag="talentdescription.factiondiscountnew">
        <Replace tag="[flooded]" value="80" color="gui.green" />
        <Replace tag="[duration]" value="15" color="gui.green" />
      </Description>
      <!-- 效果：提供20%的折扣。 -->
      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGivePermanentStat statidentifier="all~figurehead" stattype="StoreBuyMultiplierAffiliated" value="0.2" targetallies="true" setvalue="true" />
          <CharacterAbilityGivePermanentStat statidentifier="all~figurehead" stattype="ShipyardBuyMultiplierAffiliated" value="0.2" targetallies="true" setvalue="true" />
        </Abilities>
      </AbilityGroupEffect>
      <!-- 效果：使用联盟勋章时，给予自己和对方经验。 -->
      <AbilityGroupEffect abilityeffecttype="OnAttack">
        <Conditions>
          <AbilityConditionAttackData itemidentifier="coalitionmedal" />
        </Conditions>
        <Abilities>
          <!-- 等级提升到5级 -->
          <CharacterAbilityGiveExperience level="5" />
          <!-- 给予经验 -->
          <CharacterAbilityApplyStatusEffects>
            <StatusEffects>
              <StatusEffect type="OnAbility" target="This">
                <GiveExperience amount="550" />
              </StatusEffect>
            </StatusEffects>
          </CharacterAbilityApplyStatusEffects>
        </Abilities>
      </AbilityGroupEffect>
      <!-- 效果：潜艇淹没80%时保持清醒 -->
      <AbilityGroupInterval interval="1">
        <Conditions>
          <AbilityConditionShipFlooded floodpercentage="0.8" />
        </Conditions>
        <Abilities>
          <CharacterAbilityApplyStatusEffects>
            <StatusEffects>
              <StatusEffect type="OnAbility" target="Character" disabledeltatime="true" multiplyafflictionsbymaxvitality="true">
                <Affliction identifier="figureheadnew" amount="15.0" />
              </StatusEffect>
            </StatusEffects>
          </CharacterAbilityApplyStatusEffects>
        </Abilities>
      </AbilityGroupInterval>
    </Talent>
  </Talents>
