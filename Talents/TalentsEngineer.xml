      <AbilityGroupEffect abilityeffecttype="OnItemPicked">
        <Conditions>
          <AbilityConditionItem tags="door,aliendoor" />
        </Conditions>
        <Abilities>
          <CharacterAbilityModifyValue multiplyvalue="0.5" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
