<?xml version="1.0" encoding="utf-8"?>
<Override>
  <Talents>
    <!-- Researcher -->
    <!-- Hospitalizer -->
    <Talent identifier="tesp_vitaminsupplements" nameidentifier="talentname.vitaminsupplements">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,5" sheetelementsize="128,128" />
      <Description tag="talentdescription.vitaminsupplements">
        <Replace tag="[healthboost]" value="20" color="gui.green" />
      </Description>
      <AbilityGroupEffect abilityeffecttype="OnApplyTreatment">
        <Conditions>
          <AbilityConditionCharacter targettype="Ally" />
        </Conditions>
        <Abilities>
          <CharacterAbilityGiveAffliction affliction="bedsidemanner" strength="600" setvalue="true" />
        </Abilities>
      </AbilityGroupEffect>
    </Talent>
    <!-- Field surgeon -->
    <!-- 我是一个医生！而不是...（N选一，ShowCaseTalent 外壳：必须有此定义游戏才显示外壳） -->
    <Talent identifier="ntsp_imadoctornota">
      <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,6" sheetelementsize="128,128" />
      <Description tag="talentdescription.tesp_imadoctornota_base">
        <Replace tag="[amount]" value="50" color="gui.green" />
        <Replace tag="[allamount]" value="20" color="gui.green" />
        <Replace tag="[skillpercentage]" value="30" color="gui.green" />
      </Description>
    </Talent>
    <!-- 6 个选项：医疗/机械/电气/武器/舵手 各 +50（单选）；全面发展 = 5 技能各 +10。
         所有选项均带：外科技能 30% 的设计（制造）速度 + 近战/远程攻击速度加成。 -->
    <Talent identifier="tesp_imadoctornota_medical">
      <Icon texture="Content/UI/MainIconsAtlas.png" sourcerect="512,256,128,128" origin="0.5,0.5" />
      <Description tag="talentdescription.tesp_imadoctornota_skill">
        <Replace tag="[amount]" value="50" color="gui.green" />
        <Replace tag="[skillname]" value="skillname.medical" color="gui.orange" />
      </Description>
      <Description tag="talentdescription.tesp_imadoctornota_surgspeed">
        <Replace tag="[skillpercentage]" value="30" color="gui.green" />
      </Description>
      <AbilityGroupEffect abilityeffecttype="None">
        <Abilities>
          <CharacterAbilityGiveStat stattype="MedicalSkillBonus" value="50" />
        </Abilities>
      </AbilityGroupEffect>
      <AbilityGroupInterval interval="0.5">
        <Abilities>
          <CharacterAbilityModifyStatToSkill stattype="FabricationSpeed" maxvalue="0.3" skillidentifier="surgery" />
          <CharacterAbilityModifyStatToSkill stattype="MeleeAttackSpeed" maxvalue="0.3" skillidentifier="surgery" />
          <CharacterAbilityModifyStatToSkill stattype="RangedAttackSpeed" maxvalue="0.3" skillidentifier="surgery" />
        </Abilities>
      </AbilityGroupInterval>
    </Talent>
